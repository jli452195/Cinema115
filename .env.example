# 管理员配置：复制为根目录 .env 后填写。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-password
JWT_SECRET=replace-with-a-long-random-secret

# Emby 与播放器能够访问的 Cinema115 地址，请改为实际主机地址。
PUBLIC_BASE_URL=http://localhost:3002
# 从 backend 目录启动时，保存到项目根目录 data。
DATA_DIR=../data
# 本地开发的媒体库根目录；Docker 内固定为 /strm。
STRM_ROOT=../data/media
# 可留空，通过页面扫码登录后会加密保存会话。
P115_COOKIE=

# 可选 Telegram Bot。两项都填好后重启后端；消息处理参数在 STRM 页面保存。
TELEGRAM_BOT_TOKEN=
# 允许处理并回复的聊天 ID，多个用逗号分隔，群组 ID 通常为负数。
TELEGRAM_ALLOWED_CHAT_IDS=

# Docker / NAS 配置。本地 go run 和 Vite 开发不使用以下参数。
HTTP_PORT=8115
TZ=Asia/Shanghai
# NAS 上执行 id 查看实际 UID/GID，挂载目录需允许此用户写入。
PUID=1000
PGID=1000
# NAS 媒体库路径直接在 compose.yaml 的 volumes 中修改。
# Docker 部署时将上方 PUBLIC_BASE_URL 改为 http://NAS_IP:8115。
# DATA_DIR 在容器内固定为 /data，上方 ../data 仅用于本地开发。
