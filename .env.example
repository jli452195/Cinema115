# 管理员配置：复制为根目录 .env 后填写。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-password
JWT_SECRET=replace-with-a-long-random-secret

# TMDB 看板配置：填写 TMDB 账户「设置 → API」中的 API Key（v3 auth）。
# 留空时暂不启用 TMDB；密钥仅供后端使用，不填写到前端 VITE_ 变量中。
TMDB_API_KEY=
# TMDB 图片由 NAS 代理并缓存；达到上限后优先清理最久未使用的图片。
TMDB_IMAGE_CACHE_MAX_GB=5

# 从 backend 目录启动时，保存到项目根目录 data。
DATA_DIR=../data
# 本地开发的媒体库根目录；Docker 内固定为 /strm。
STRM_ROOT=../data/media

# 后端实际监听端口，Go/Air 与 Docker 均生效；未设置时后端默认 3002。
# host 部署直接访问 NAS_IP:8115；Vite 开发代理同步读取此配置。
HTTP_PORT=8115
# Docker / NAS 配置。Emby 反代端口在网页设置，host 模式不需要映射。
TZ=Asia/Shanghai
# NAS 上执行 id 查看实际 UID/GID，挂载目录需允许此用户写入。
PUID=1000
PGID=1000
# NAS 媒体库路径直接在 compose.yaml 的 volumes 中修改。
# 播放地址及 Telegram Bot 均在网页中配置并保存。
# DATA_DIR 在容器内固定为 /data，上方 ../data 仅用于本地开发。
